PORT=5050
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/DATABASE?retryWrites=true&w=majority
JWT_SECRET=придумайте-длинный-секретный-ключ-минимум-32-символа

# URL фронтенда (ссылка «Подтвердить email» в письмах). Совпадайте с портом из вывода Vite (по умолчанию 5174).
CLIENT_URL=http://localhost:5174

# --- Почта (без этого письма с подтверждением НЕ уходят на mail.ru и др.) ---
# В development ссылка дублируется в консоли сервера и в поле devVerificationUrl ответа API.
#
# Пример Mail.ru (отправка с вашего ящика @mail.ru):
#   В настройках почты включите SMTP и при необходимости создайте «Пароль для внешних приложений».
# SMTP_HOST=smtp.mail.ru
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=ваш_логин@mail.ru
# SMTP_PASS=ваш_пароль_или_пароль_приложения
# SMTP_FROM="Онлайн-библиотека <ваш_логин@mail.ru>"
#
# Gmail: в коде для smtp.gmail.com используется пресет nodemailer (меньше ошибок TLS).
# Достаточно SMTP_HOST=smtp.gmail.com, USER, PASS, FROM; SMTP_PORT/SMTP_SECURE можно не задавать.
# SMTP_PASS — только «пароль приложения» из настроек Google, не обычный пароль.
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxx
# SMTP_FROM="Онлайн-библиотека <you@gmail.com>"
